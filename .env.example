# Slack OAuth credentials (never commit real values)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Used later for Events API / Socket Mode verification (optional for OAuth)
SLACK_SIGNING_SECRET=
# Must match the Redirect URL configured in your Slack app
SLACK_REDIRECT_URI=https://localhost/slack/oauth/callback

# Admin gate (no database — checked against these values only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Optional alias for ADMIN_USERNAME:
# ADMIN_EMAIL=admin@example.com
